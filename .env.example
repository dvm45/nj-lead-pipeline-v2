# NJ Lead Pipeline - environment settings
# Copy this file to ".env" and fill in the values for your provider. The
# real .env is gitignored.
#
#   copy .env.example .env    (windows)
#   cp .env.example .env      (mac/linux)

# ---------------------------------------------------------------------------
# Which provider to call Claude through:
#   "bedrock"    -> AWS Bedrock (uses your AWS credentials, no API key)
#   "anthropic"  -> Anthropic's direct API (uses ANTHROPIC_API_KEY below)
# ---------------------------------------------------------------------------
NJLEAD_LLM_PROVIDER=bedrock


# ---------------------------------------------------------------------------
# Bedrock settings (only used when NJLEAD_LLM_PROVIDER=bedrock).
#
# Credentials - pick ONE of these three paths (checked in priority order):
#
#   1. Bedrock long-term API key (RECOMMENDED for local runs).
#      Generate it in the AWS console:
#      Bedrock -> API keys -> "Generate long-term API key".
#      Paste it below. It's a bearer token; boto3 picks it up automatically
#      for Bedrock calls.
#
#   2. Standard IAM access key pair (env vars OR ~/.aws/credentials from
#      `aws configure`). Use this if you want the same credentials to work
#      for other AWS services too.
#
#   3. EC2 / ECS instance role. Nothing to configure in .env - the pipeline
#      picks up credentials from the instance metadata service automatically.
#      This is the path you'll use once the UI is deployed to a VM.
#
# The region below is the one you approved Sonnet 4.5 model access in.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-2

# Path 1: Bedrock API key. Paste your long-term key here.
AWS_BEARER_TOKEN_BEDROCK=

# Path 2 (alternative to above): IAM access key pair.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Bedrock's model ID for Claude Sonnet 4.5 (Anthropic calls this Sonnet 4.6
# on their direct API - AWS keeps the original release name). The "us."
# prefix is a US-inference-profile ID and is REQUIRED in us-east-2. Only
# change this if you switch to a non-US region.
# NJLEAD_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0


# ---------------------------------------------------------------------------
# Anthropic-direct settings (only used when NJLEAD_LLM_PROVIDER=anthropic).
# Leave blank if you're using Bedrock.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# NJLEAD_ANTHROPIC_MODEL=claude-sonnet-4-5


# ---------------------------------------------------------------------------
# Provider-neutral tuning (safe defaults are used if you leave these out):
# ---------------------------------------------------------------------------
# NJLEAD_LLM_MAX_TOKENS=16384
# NJLEAD_CONFIDENCE_THRESHOLD=0.70
# NJLEAD_SCAN_DPI=150


# ---------------------------------------------------------------------------
# Google Drive integration (for the web UI on EC2).
# Leave blank to skip Drive sync and use local input_pdfs/ folder instead.
#
# To get folder IDs: open the folder in Google Drive, copy the last part of
# the URL. Example: https://drive.google.com/drive/folders/1aBcDeFgHiJ
#                                                          ^^^^^^^^^^^^ this
# ---------------------------------------------------------------------------
GDRIVE_INPUT_FOLDER_ID=
GDRIVE_OUTPUT_FOLDER_ID=
GDRIVE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
