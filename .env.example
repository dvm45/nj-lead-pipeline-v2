# NJ Lead Pipeline - environment settings
# Copy this file to ".env" and fill in your key. The real .env is gitignored.
#
#   cp .env.example .env      (mac/linux)
#   copy .env.example .env    (windows)

# Your Anthropic API key. Get one at https://console.anthropic.com/ -> API Keys.
# Leave blank for now; the pipeline is wired and ready, and only the
# `--engine llm` path needs it. Everything else runs without a key.
ANTHROPIC_API_KEY=

# Optional overrides (safe defaults are used if you leave these out):
# NJLEAD_LLM_MODEL=claude-sonnet-4-6
# NJLEAD_LLM_MAX_TOKENS=4096
# NJLEAD_CONFIDENCE_THRESHOLD=0.70
# NJLEAD_SCAN_DPI=150
