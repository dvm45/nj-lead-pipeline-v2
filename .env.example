# NJ Lead Pipeline — environment settings
# Copy this file to ".env" and fill in the values.
#
#   copy .env.example .env

# ---- AWS Bedrock (default provider) ----------------------------------------
# Paste your Bedrock long-term API key here. Generate one in the AWS console:
#   Bedrock → API keys → "Generate long-term API key"
AWS_BEARER_TOKEN_BEDROCK=

# Region where you have Bedrock model access
AWS_REGION=us-east-2

# Alternative: IAM access key pair (instead of the bearer token above)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Google Drive -----------------------------------------------------------
# Folder IDs from the Drive URL (the last part after /folders/)
GDRIVE_INPUT_FOLDER_ID=
GDRIVE_OUTPUT_FOLDER_ID=

# Path to your Google service account JSON key file
GDRIVE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# ---- Optional tuning -------------------------------------------------------
# NJLEAD_LLM_PROVIDER=bedrock          # "bedrock" or "anthropic"
# NJLEAD_BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1
# NJLEAD_LLM_MAX_TOKENS=16384
# NJLEAD_CONFIDENCE_THRESHOLD=0.70
# NJLEAD_SCAN_DPI=150

# ---- Anthropic direct API (only if NJLEAD_LLM_PROVIDER=anthropic) ----------
# ANTHROPIC_API_KEY=sk-ant-...
# NJLEAD_ANTHROPIC_MODEL=claude-opus-4-6
